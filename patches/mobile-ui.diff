--- lib/vscode/src/vs/code/browser/workbench/workbench.html
+++ lib/vscode/src/vs/code/browser/workbench/workbench.html
@@ -25,4 +25,32 @@
 	<!-- Workbench -->
 	<div class="monaco-workbench" id="monaco-workbench"></div>
 
+	<style>
+		html, body, .monaco-workbench { position: fixed !important; top: 0 !important; bottom: 0 !important; left: 0 !important; right: 0 !important; width: 100vw !important; height: 100dvh !important; overflow: hidden !important; }
+		.editor-instance, .monaco-scrollable-element { touch-action: pan-x pan-y !important; }
+	</style>
+	<script>
+		window.addEventListener('load', () => {
+			const collapse = () => {
+				const s = document.querySelector('.part.sidebar');
+				if (s && s.offsetWidth > 10) {
+					const tab = document.querySelector('.part.activitybar .action-item.checked, .part.activitybar .action-item[aria-expanded="true"]');
+					if (tab) {
+						tab.dispatchEvent(new MouseEvent('mousedown', { bubbles: true, cancelable: true }));
+						tab.dispatchEvent(new MouseEvent('mouseup', { bubbles: true, cancelable: true }));
+					}
+				}
+			};
+			document.body.addEventListener('pointerup', (e) => {
+				if (e.target.closest('.part.editor')) {
+					collapse();
+				} else if (e.target.closest('.part.sidebar .monaco-list-row')) {
+					if (!e.target.closest('.monaco-tl-twistie, .collapsible')) {
+						setTimeout(collapse, 400);
+					}
+				}
+			}, { passive: true });
+		});
+	</script>
 </body>
 </html>
